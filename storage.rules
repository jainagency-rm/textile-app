rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isImageOrPdf() {
      // Bracket () add kiye gaye taaki AND/OR logic theek se kaam kare
      // request.resource != null check karta hai ki file actual me upload ho rahi hai (delete nahi)
      return request.resource != null 
          && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('application/pdf'))
          && request.resource.size < 5 * 1024 * 1024; // 5 MB limit
    }

    // 1. User specific folder
    match /users/{userId}/{fileName=**} {
      allow read: if isAuthenticated(); 
      allow create, update: if isAuthenticated() && request.auth.uid == userId && isImageOrPdf();
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // 2. Products folder (Suppliers ke liye)
    match /products/{fileName=**} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isImageOrPdf();
      allow delete: if isAuthenticated();
    }

    // 3. Designs folder — allow read/write for any authenticated user
    match /designs/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 4. Default Deny (Baaki sab locked)
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}